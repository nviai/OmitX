    "Tiến trình nền chạy ngay cả khi cửa sổ OmitX đã đóng — đó là điều kiện để cảnh báo trước khi ổ cứng đầy." : {
      "comment" : "Sources/OmitX/Views/AutomationView.swift:75",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر عملية الخلفية في العمل حتى عند إغلاق نافذة OmitX — وهذا ما يتيح التنبيه قبل امتلاء القرص."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El procés en segon pla continua funcionant encara que tanquis la finestra de l’OmitX: és el que permet avisar-te abans que el disc s’ompli."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proces na pozadí běží dál, i když je okno OmitX zavřené — právě díky tomu lze varovat dřív, než se disk zaplní."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baggrundsprocessen kører videre, også når OmitX-vinduet er lukket — kun sådan kan der advares, før disken bliver fuld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hintergrundprozess läuft weiter, auch wenn das OmitX-Fenster geschlossen ist — nur so lässt sich warnen, bevor das Volume voll ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η διεργασία παρασκηνίου συνεχίζει να εκτελείται ακόμη κι όταν το παράθυρο του OmitX είναι κλειστό — αυτό επιτρέπει την προειδοποίηση πριν γεμίσει ο δίσκος."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The background process keeps running even after the OmitX window is closed — that's what makes it possible to warn you before the disk fills up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proceso en segundo plano sigue funcionando aunque cierres la ventana de OmitX: es lo que permite avisarte antes de que el disco se llene."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taustaprosessi jatkaa toimintaansa silloinkin, kun OmitX-ikkuna on suljettu — juuri siksi voidaan varoittaa ennen kuin levy täyttyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le processus en arrière-plan continue même quand la fenêtre d’OmitX est fermée — c’est ce qui permet d’avertir avant que le disque ne soit plein."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תהליך הרקע ממשיך לפעול גם כשחלון OmitX סגור — בזכות זה אפשר להתריע לפני שהדיסק יתמלא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OmitX विंडो बंद होने पर भी पृष्ठभूमि प्रक्रिया चलती रहती है — इसी वजह से डिस्क भरने से पहले चेतावनी दी जा सकती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozadinski proces nastavlja raditi i kad je prozor OmitX zatvoren — upravo to omogućuje upozorenje prije nego se disk napuni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A háttérfolyamat akkor is fut, ha az OmitX ablaka be van zárva — ez teszi lehetővé, hogy figyelmeztessen, mielőtt megtelik a lemez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proses latar tetap berjalan meski jendela OmitX ditutup — itulah yang memungkinkan peringatan muncul sebelum disk penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il processo in background continua a girare anche a finestra di OmitX chiusa: è ciò che permette di avvisarti prima che il disco si riempia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドプロセスは OmitX のウインドウを閉じても動き続けます。ディスクがいっぱいになる前に警告できるのはそのためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 프로세스는 OmitX 윈도우를 닫아도 계속 실행됩니다. 디스크가 차기 전에 경고할 수 있는 이유입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proses latar tetap berjalan walaupun tetingkap OmitX ditutup — itulah yang membolehkan amaran muncul sebelum cakera penuh."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrunnsprosessen fortsetter å kjøre selv når OmitX-vinduet er lukket — det er det som gjør at du kan varsles før disken blir full."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het achtergrondproces blijft draaien, ook als het OmitX-venster gesloten is — alleen zo kan er gewaarschuwd worden voordat de schijf vol raakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proces w tle działa dalej, nawet gdy okno OmitX jest zamknięte — to dzięki temu można ostrzec, zanim dysk się zapełni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O processo em segundo plano continua rodando mesmo com a janela do OmitX fechada — é isso que permite avisar antes do disco encher."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O processo em segundo plano continua a correr mesmo com a janela do OmitX fechada — é isso que permite avisar antes do disco encher."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesul din fundal continuă să ruleze chiar și când fereastra OmitX e închisă — tocmai asta permite avertizarea înainte ca discul să se umple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновый процесс продолжает работать, даже когда окно OmitX закрыто — именно поэтому можно предупредить до того, как диск заполнится."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proces na pozadí beží ďalej, aj keď je okno OmitX zatvorené — práve vďaka tomu možno varovať skôr, než sa disk zaplní."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proces v ozadju teče naprej tudi, ko je okno OmitX zaprto — prav to omogoča opozorilo, preden se disk napolni."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bakgrundsprocessen fortsätter köra även när OmitX-fönstret är stängt — det är det som gör att du kan varnas innan skivan blir full."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรเซสเบื้องหลังยังทำงานต่อแม้ปิดหน้าต่าง OmitX แล้ว — นั่นคือสิ่งที่ทำให้เตือนได้ก่อนดิสก์เต็ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan işlemi OmitX penceresi kapalıyken bile çalışmayı sürdürür — disk dolmadan önce uyarabilmeyi sağlayan şey budur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновий процес працює далі, навіть коли вікно OmitX закрите — саме тому можна попередити ще до того, як диск заповниться."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使关闭 OmitX 窗口，后台进程仍会继续运行 — 只有这样才能在磁盘写满之前发出警告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使關閉 OmitX 視窗，背景程序仍會繼續執行 — 只有這樣才能在磁碟寫滿之前發出警告。"
          }
        },
        "vi" : {
          "stringUnit" : {
