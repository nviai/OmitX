    "Nhả máy này trước khi bán hoặc cài lại máy, để dùng mã ở máy khác mà không cần mã xác nhận." : {
      "comment" : "Sources/OmitX/Views/SettingsView.swift:164",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرّر هذا الجهاز قبل بيعه أو إعادة تثبيت النظام، لتستخدم الرمز على جهاز آخر دون الحاجة إلى رمز تأكيد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allibera aquest Mac abans de vendre’l o reinstal·lar-lo, així podràs fer servir el codi en un altre Mac sense codi de confirmació."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvolni tenhle Mac před prodejem nebo přeinstalací, ať kód použiješ jinde bez potvrzovacího kódu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigiv denne Mac, før du sælger eller geninstallerer, så koden kan bruges på en anden Mac uden bekræftelseskode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib diesen Mac frei, bevor du ihn verkaufst oder neu aufsetzt – dann funktioniert der Code ohne Bestätigungscode auf einem anderen Mac."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποδέσμευσε αυτό το Mac πριν το πουλήσεις ή το εγκαταστήσεις από την αρχή, ώστε ο κωδικός να δουλεύει σε άλλο Mac χωρίς κωδικό επιβεβαίωσης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Release this Mac before selling or reinstalling, so the code works on another Mac without a confirmation code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera este Mac antes de venderlo o reinstalarlo, así el código funcionará en otro Mac sin código de confirmación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vapauta tämä Mac ennen myyntiä tai uudelleenasennusta, niin koodi toimii toisella Macilla ilman vahvistuskoodia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez ce Mac avant de le vendre ou de le réinstaller : le code fonctionnera sur un autre Mac sans code de confirmation."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שחרר את ה‑Mac הזה לפני מכירה או התקנה מחדש, כדי שהקוד יעבוד ב‑Mac אחר בלי קוד אישור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बेचने या दोबारा इंस्टॉल करने से पहले यह Mac मुक्त करें, ताकि कोड दूसरे Mac पर बिना पुष्टि कोड के चले।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oslobodi ovaj Mac prije prodaje ili ponovne instalacije kako bi kod radio na drugom Macu bez koda za potvrdu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szabadítsd fel ezt a Macet eladás vagy újratelepítés előtt, így a kód megerősítő kód nélkül működik másik Macen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepaskan Mac ini sebelum dijual atau diinstal ulang, supaya kodenya bisa dipakai di Mac lain tanpa kode konfirmasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera questo Mac prima di venderlo o reinstallarlo: così il codice funziona su un altro Mac senza codice di conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "売却や再インストールの前にこの Mac を解除しておくと、確認コードなしで別の Mac でコードを使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "판매하거나 재설치하기 전에 이 Mac을 해제하면 확인 코드 없이 다른 Mac에서 코드를 쓸 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lepaskan Mac ini sebelum menjual atau memasang semula, supaya kod boleh digunakan pada Mac lain tanpa kod pengesahan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigi denne Macen før du selger eller installerer på nytt, så koden virker på en annen Mac uten bekreftelseskode."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef deze Mac vrij voordat je hem verkoopt of opnieuw installeert, dan werkt de code op een andere Mac zonder bevestigingscode."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwolnij tego Maca przed sprzedażą lub reinstalacją, żeby kod działał na innym Macu bez kodu potwierdzającego."
