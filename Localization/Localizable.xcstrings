    "Chat chọn sẵn các mục rồi mở bảng xác nhận để bạn duyệt." : {
      "comment" : "Sources/OmitX/Pro/Models/ChatTypes.swift:19",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
