          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попереджає до того, як диск заповниться, і прибирає за вашими правилами — навіть коли вікно OmitX закрите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在磁盘写满之前提醒你，并按你设定的规则清理，即使关闭 OmitX 窗口也照常运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在磁碟寫滿之前提醒你，並按你設定的規則清理，即使關閉 OmitX 視窗也照常執行。"
          }
