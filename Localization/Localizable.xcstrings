        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cảnh báo trước khi ổ cứng đầy và tự dọn theo quy tắc bạn đặt, kể cả khi đã đóng cửa sổ OmitX."
          }
        }
      }
    },
