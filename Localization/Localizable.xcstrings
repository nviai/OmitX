          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour mesurer la Corbeille, Mail, les sauvegardes d’iPhone et les données des autres apps, accordez à OmitX l’Accès complet au disque."
