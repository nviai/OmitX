    "Cảnh báo trước khi ổ cứng đầy và tự dọn theo quy tắc bạn đặt, kể cả khi đã đóng cửa sổ OmitX." : {
      "comment" : "Sources/OmitX/Pro/ProGateView.swift:178",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينبّهك قبل امتلاء القرص وينظّف وفق القواعد التي تضعها، حتى عندما تكون نافذة OmitX مغلقة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "T’avisa abans que el disc s’ompli i neteja segons les teves regles, fins i tot amb la finestra de l’OmitX tancada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní dřív, než se disk zaplní, a uklidí podle tvých pravidel — i se zavřeným oknem OmitX."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarer dig, før disken bliver fuld, og rydder op efter dine regler — også når OmitX-vinduet er lukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnt dich, bevor das Volume voll ist, und räumt nach deinen Regeln auf — auch bei geschlossenem OmitX-Fenster."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σας προειδοποιεί πριν γεμίσει ο δίσκος και καθαρίζει με τους κανόνες σας, ακόμη και με κλειστό το παράθυρο του OmitX."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warns you before the disk fills up and cleans by the rules you set, even with the OmitX window closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisa antes de que el disco se llene y limpia según tus reglas, incluso con la ventana de OmitX cerrada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varoittaa ennen kuin levy täyttyy ja siivoaa asettamiesi sääntöjen mukaan — myös OmitX-ikkunan ollessa suljettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avertit avant que le disque ne soit plein et nettoie selon vos règles, même fenêtre OmitX fermée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתריע לפני שהדיסק יתמלא ומנקה לפי הכללים שלכם — גם כשחלון OmitX סגור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क भरने से पहले चेतावनी देता है और आपके नियमों के अनुसार साफ़ करता है — OmitX विंडो बंद होने पर भी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorava prije nego se disk napuni i čisti prema tvojim pravilima — čak i kad je prozor OmitX zatvoren."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Figyelmeztet, mielőtt megtelik a lemez, és a szabályaid szerint takarít — akkor is, ha az OmitX ablaka be van zárva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memperingatkan sebelum disk penuh dan membersihkan sesuai aturan Anda, bahkan saat jendela OmitX ditutup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisa prima che il disco si riempia e pulisce secondo le tue regole, anche a finestra OmitX chiusa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクがいっぱいになる前に警告し、設定したルールに従って整理します。OmitX のウインドウを閉じていても動きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크가 차기 전에 알려 주고, 설정한 규칙에 따라 정리합니다. OmitX 윈도우를 닫아도 동작합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberi amaran sebelum cakera penuh dan membersihkan mengikut peraturan anda, walaupun tetingkap OmitX ditutup."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler deg før disken blir full og rydder etter reglene dine — også når OmitX-vinduet er lukket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwt voordat de schijf vol raakt en ruimt op volgens jouw regels, ook als het OmitX-venster dicht is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostrzega, zanim dysk się zapełni, i sprząta według Twoich reguł — nawet przy zamkniętym oknie OmitX."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa antes de o disco encher e limpa pelas regras que você definiu, mesmo com a janela do OmitX fechada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa antes de o disco encher e limpa pelas regras que definiu, mesmo com a janela do OmitX fechada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avertizează înainte ca discul să se umple și curăță după regulile tale — chiar și cu fereastra OmitX închisă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждает до того, как диск заполнится, и убирает по вашим правилам — даже когда окно OmitX закрыто."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorní skôr, než sa disk zaplní, a upratá podľa tvojich pravidiel — aj so zatvoreným oknom OmitX."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opozori, preden se disk napolni, in počisti po tvojih pravilih — tudi ko je okno OmitX zaprto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
