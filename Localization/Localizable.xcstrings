    "macOS chỉ báo khi ổ đã gần cạn. Đặt ngưỡng cao hơn để còn kịp xử lý." : {
      "comment" : "Sources/OmitX/Views/AutomationView.swift:103",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ينبّه macOS إلا عندما يوشك القرص على النفاد. اضبط عتبة أعلى لتترك لنفسك وقتًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El macOS només avisa quan el disc és gairebé buit. Posa un llindar més alt per tenir temps d’actuar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS varuje, až když je disk skoro prázdný. Nastavte vyšší práh, abyste měli čas zareagovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS advarer først, når disken næsten er tom. Sæt en højere grænse, så du har tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS warnt erst, wenn das Volume fast leer ist. Setze einen höheren Schwellenwert, damit dir Zeit bleibt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το macOS προειδοποιεί μόνο όταν ο δίσκος είναι σχεδόν άδειος. Ορίστε υψηλότερο όριο για να προλάβετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS only warns you once the disk is nearly empty. Set a higher threshold to leave yourself time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS solo avisa cuando el disco está casi vacío. Pon un umbral más alto para darte margen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS varoittaa vasta, kun levy on melkein tyhjä. Aseta korkeampi raja, niin ehdit toimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’avertit que lorsque le disque est presque vide. Fixez un seuil plus élevé pour vous laisser le temps d’agir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏macOS מתריע רק כשהדיסק כמעט ריק. קבעו סף גבוה יותר כדי להשאיר לעצמכם זמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS तभी चेतावनी देता है जब डिस्क लगभग ख़ाली हो चुकी हो। समय मिलने के लिए ऊँची सीमा तय करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS upozorava tek kad je disk gotovo prazan. Postavi viši prag da imaš vremena reagirati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS csak akkor figyelmeztet, amikor a lemez már majdnem üres. Állíts be magasabb küszöböt, hogy maradjon időd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS baru memperingatkan saat disk hampir habis. Setel ambang lebih tinggi agar Anda punya waktu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS avvisa solo quando il disco è quasi vuoto. Imposta una soglia più alta per avere il tempo di intervenire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS はディスクがほぼ空になってから警告します。対処する時間を残すには、高めのしきい値を設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS는 디스크가 거의 비어야 경고합니다. 대처할 시간을 남기려면 임계값을 더 높게 설정하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hanya memberi amaran apabila cakera hampir habis. Tetapkan ambang lebih tinggi supaya anda ada masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS varsler først når disken nesten er tom. Sett en høyere grense så du rekker å gjøre noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS waarschuwt pas als de schijf bijna leeg is. Stel een hogere drempel in zodat je tijd overhoudt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ostrzega dopiero, gdy dysk jest prawie pusty. Ustaw wyższy próg, żeby mieć czas zareagować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS só avisa quando o disco já está quase vazio. Defina um limite mais alto para ter tempo de agir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS só avisa quando o disco já está quase vazio. Defina um limite mais alto para ter tempo de agir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS avertizează abia când discul e aproape gol. Setează un prag mai mare ca să ai timp să reacționezi."
          }
        },
        "ru" : {
          "stringUnit" : {
