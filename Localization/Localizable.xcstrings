          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההגדרות, ההתחברויות, ה-skills, התוספים והזיכרון של הסוכנים לעולם אינם נמחקים."
          }
        },
        "hi" : {
