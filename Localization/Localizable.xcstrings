          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no puede ejecutar Apple Intelligence: el asistente necesita un Mac con chip de Apple."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
