    "Máy này không chạy được Apple Intelligence — trợ lý cần Mac chip Apple." : {
      "comment" : "Sources/OmitX/Pro/Models/ChatTypes.swift:45",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الـ Mac تشغيل Apple Intelligence — يحتاج المساعد إلى Mac بمعالج Apple."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest Mac no pot executar Apple Intelligence: l’assistent necessita un Mac amb xip d’Apple."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento Mac nedokáže spustit Apple Intelligence — asistent potřebuje Mac s čipem Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne Mac kan ikke køre Apple Intelligence — assistenten kræver en Mac med Apple-chip."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann Apple Intelligence nicht ausführen — der Assistent braucht einen Mac mit Apple Chip."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το Mac δεν μπορεί να εκτελέσει το Apple Intelligence — ο βοηθός χρειάζεται Mac με τσιπ Apple."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac can't run Apple Intelligence — the assistant needs an Apple silicon Mac."
          }
        },
