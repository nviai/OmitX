    "Dừng Gradle daemon rồi xoá. Lần build sau sẽ tải lại dependency." : {
      "comment" : "Sources/OmitX/Modules/AndroidModule.swift:20",
      "localizations" : {
        "en" : {
          "stringUnit" : {
