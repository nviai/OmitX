    "Nói tôi cần dọn gì, tôi chọn sẵn rồi bạn duyệt." : {
      "comment" : "Sources/OmitX/Views/ChatPanel.swift:262",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
