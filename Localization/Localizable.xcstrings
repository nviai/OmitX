    "Cấu hình, đăng nhập, skills, plugins và memory của các agent không bao giờ bị xoá." : {
      "comment" : "Sources/OmitX/Modules/AIAgentModule.swift:81",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم حذف إعدادات الوكلاء أو تسجيلات الدخول أو المهارات أو الإضافات أو الذاكرة أبدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuració, els inicis de sessió, les skills, els plugins i la memòria dels agents no s'eliminen mai."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurace, přihlášení, skills, pluginy a paměť agentů se nikdy nemažou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenternes konfiguration, logins, skills, plugins og hukommelse slettes aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfiguration, Anmeldungen, Skills, Plugins und Speicher der Agenten werden nie gelöscht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ρυθμίσεις, οι συνδέσεις, τα skills, τα plugins και η μνήμη των agents δεν διαγράφονται ποτέ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent config, logins, skills, plugins and memory are never deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración, los inicios de sesión, las skills, los plugins y la memoria de los agentes nunca se eliminan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
