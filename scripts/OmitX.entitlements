<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Cleaning some system locations asks for an admin password through AppleScript
         (Shell.runAdmin). Under the hardened runtime that needs this entitlement. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
